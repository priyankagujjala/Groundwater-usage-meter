# Database URL (leave unset to default to local SQLite: sqlite:///groundwater.db)
# Example PostgreSQL: postgresql://username:password@ep-host.neon.tech/groundwater?sslmode=require
DATABASE_URL=

# MQTT Broker Configuration (EMQX Cloud Serverless)
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Allowed CORS Origins (comma-separated, include frontend URLs)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080,http://localhost:3000,http://127.0.0.1:8000,http://127.0.0.1:8080,https://*.netlify.app

# Razorpay Credentials (Test Mode - Last Task)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
