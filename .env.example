# ==============================================================================
# Groundwater Usage Meter with Pay-on-Excess - Environment Variables
# ==============================================================================

# EMQX Serverless broker hostname (e.g. x1234567.ala.eu-central-1.emqx.cloud)
MQTT_HOST=your-emqx-deployment.emqx.cloud

# MQTT broker port (8883 for TLS/SSL)
MQTT_PORT=8883

# Enable TLS encryption for secure broker connection (true/false)
MQTT_USE_TLS=true

# Optional path to custom CA certificate file (leave blank to use certifi bundle)
MQTT_CA_CERT=

# MQTT username for device simulator authentication
MQTT_USERNAME=your_emqx_username

# MQTT password for device simulator authentication
MQTT_PASSWORD=your_emqx_password

# Optional dedicated MQTT username for backend ingestion (falls back to MQTT_USERNAME if blank)
MQTT_BACKEND_USERNAME=your_backend_username

# Optional dedicated MQTT password for backend ingestion (falls back to MQTT_PASSWORD if blank)
MQTT_BACKEND_PASSWORD=your_backend_password

# PostgreSQL connection string for Neon/Supabase (must include sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Target device identifier used in MQTT topic namespaces (gw/<DEVICE_ID>/...)
DEVICE_ID=device1
